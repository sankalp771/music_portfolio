# Set the production HTTPS origin after the artist domain is chosen.
NEXT_PUBLIC_SITE_URL=

# Create/select a Sanity project and dataset, then uncomment/fill both values.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional webmaster verification values from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
